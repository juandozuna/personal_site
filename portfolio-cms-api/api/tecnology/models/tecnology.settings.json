{
  "kind": "collectionType",
  "collectionName": "tecnologies",
  "info": {
    "name": "Tecnology"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "yearsOfExperience": {
      "type": "integer",
      "required": true
    },
    "domainValue": {
      "type": "decimal",
      "default": 5,
      "required": true,
      "max": 10,
      "min": 0
    },
    "svgLogo": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "images"
      ],
      "plugin": "upload",
      "required": false
    },
    "logoPng": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "images"
      ],
      "plugin": "upload",
      "required": false
    },
    "projects": {
      "via": "tecnologies",
      "collection": "project"
    },
    "skills": {
      "via": "tecnology",
      "collection": "skills"
    }
  }
}
